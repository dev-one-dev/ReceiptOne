# Copy to .env.local and fill in. VITE_* values are exposed to the browser.

# External origins (defaults shown; override for previews / local app dev)
VITE_APP_URL=https://app.receipt-one.com
VITE_SITE_URL=https://receipt-one.com

# Firebase (project check-app-a93a2). The contact form and the feature-idea
# widget call the portal's Cloud Functions through this client; App Check
# (reCAPTCHA v3) is required for those callables, so the site key is not optional.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
VITE_FIREBASE_APP_CHECK_SITE_KEY=
VITE_GOOGLE_MAPS_API_KEY=
