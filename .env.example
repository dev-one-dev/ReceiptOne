# Copy to .env.local and fill in. VITE_* values are exposed to the browser.

# External origins (defaults shown; override for previews / local app dev)
VITE_APP_URL=https://app.receipt-one.com
VITE_SITE_URL=https://receipt-one.com
VITE_APP_STORE_URL=https://apps.apple.com/us/app/receiptone-expense-tracker/id6755740822
VITE_PLAY_STORE_URL=https://play.google.com/store/apps/details?id=com.appfyl.checkapp

# Supabase (helpdesk)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Firebase
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
VITE_FIREBASE_APP_CHECK_SITE_KEY=
VITE_GOOGLE_MAPS_API_KEY=

# Server-only (helpdesk notifications)
RESEND_API_KEY=
HELPDESK_WEBHOOK_SECRET=
HELPDESK_NOTIFY_EMAIL=
ADMIN_USER_IDS=
